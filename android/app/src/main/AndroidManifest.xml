<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ═══════════════════════════════════════════════════════════════════════
         AegisLock — Android Permissions Configuration

         Each permission is required for a specific security module:
         - INTERNET: Gemini API calls and alert email dispatch
         - USE_BIOMETRIC / USE_FINGERPRINT: Native biometric authentication
         - SYSTEM_ALERT_WINDOW: Lock screen overlay above other apps
         - CAMERA: Front camera capture for intrusion evidence
         - ACCESS_FINE_LOCATION: GPS coordinates for intrusion alerts
         - EXPAND_STATUS_BAR: Status bar management during lock mode
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Network access for Gemini API and alert email dispatch -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric authentication — fingerprint unlock module -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- System alert window — allows lock screen overlay above all apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Camera access — front camera capture for intrusion evidence -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Fine GPS location — pinpoint device location during intrusion -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Status bar control — prevent user from pulling down notifications -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!--
        MainActivity — AegisLock main entry point

        showWhenLocked: Allows the activity to display over the device lock screen
        turnScreenOn: Wakes the screen when the activity is launched
        These attributes ensure AegisLock can operate as a true lock screen overlay
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        android:showWhenLocked="true"
        android:turnScreenOn="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
